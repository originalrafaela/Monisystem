# Server configuration only. Never copy these variables to the Android app.
MONISYSTEM_ENV=production
GCLOUD_PROJECT=monisystem-f6d63
# Firebase Console > Project settings > Service accounts. Secret JSON; leave empty here.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Supabase project URL and private bucket. No public object URL.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=monisystem-photos
# Supabase server secret/service_role key. Never use EXPO_PUBLIC_ for this.
SUPABASE_SERVICE_ROLE_KEY=
# Render supplies PORT; local server defaults to 10000.
